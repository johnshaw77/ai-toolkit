
      Object.assign(IC, {
        calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
        hourglass: '<path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/>',
        door: '<path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>',
        video: '<path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/>',
        user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
        users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
        crown: '<path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/>',
        shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
        link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>'
      });
      var GREY = "#b0b0b8", STEEL = "#8aa0c8";
      function hid(list) { list.forEach(function (s) { gsap.set(s, { opacity: 0 }); }); }
      function fmt(m) { var mi = Math.floor(m + 1e-6), h = Math.floor(mi / 60), mm = mi % 60; return (h < 10 ? "0" : "") + h + ":" + (mm < 10 ? "0" : "") + mm; }

      var gm = grp("gm"), g9 = grp("g9");
      gsap.set(g9, { opacity: 0 });

      /* ---- timeline bar (top) ---- */
      var SEG = [{ x: 100, w: 700, c: C.orange, lab: "等待主持人" }, { x: 800, w: 330, c: C.blue, lab: "可先進場" }, { x: 1130, w: 370, c: C.green, lab: "會議進行中" }];
      var tlb = grp("tlb", gm);
      SEG.forEach(function (s, i) {
        el("rect", { x: s.x + 2, y: 142, width: s.w - 4, height: 56, rx: 10, fill: C.track }, tlb);
        var f = el("rect", { id: "sf" + i, x: s.x + 2, y: 142, width: s.w - 4, height: 56, rx: 10, fill: s.c }, tlb);
        gsap.set(f, { scaleX: 0, transformOrigin: "0% 50%" });
        txt("segT" + i, s.x + s.w / 2, 102, s.lab, "pt", s.c, 32, gm); gsap.set("#segT" + i, { opacity: 0 });
      });
      var TK = [{ x: 100, t: "09:58", c: "建立" }, { x: 800, t: "11:15", c: "開放進場" }, { x: 1130, t: "11:30", c: "開始" }, { x: 1500, t: "12:00", c: "結束" }];
      TK.forEach(function (k, i) {
        var g = grp("tkg" + i, gm);
        el("path", { d: "M" + k.x + " 208 V228", stroke: C.grey, "stroke-width": 3, fill: "none" }, g);
        txt("tk" + i, k.x, 258, k.t, "mono", C.text, 30, g, "middle");
        txt("tkc" + i, k.x, 296, k.c, "pt", C.dim, 24, g);
        gsap.set(g, { opacity: 0 });
      });
      var ph = el("g", { id: "ph" }, gm);
      el("circle", { cx: 0, cy: 0, r: 17, fill: "#ffffff", stroke: "#0e0e10", "stroke-width": 4 }, ph);
      gsap.set(ph, { x: 100, y: 170, opacity: 0 });
      hid(["#tlb"]);

      /* ---- state card (S1-S5) ---- */
      var gs = grp("gs", gm);
      el("rect", { id: "gsFace", x: 400, y: 380, width: 800, height: 360, rx: 28, fill: C.card, stroke: GREY, "stroke-width": 4, filter: "url(#sh)" }, gs);
      var ring = el("circle", { id: "gsRing", cx: 560, cy: 560, r: 92, fill: "#141417", "stroke-width": 7 }, gs); gsap.set(ring, { stroke: GREY });
      var ST = [{ ic: "calendar", name: "新會議", c: GREY }, { ic: "hourglass", name: "等待主持人", c: C.orange }, { ic: "door", name: "可先進場", c: C.blue }, { ic: "video", name: "會議進行中", c: C.green }];
      ST.forEach(function (s, i) {
        var w = el("g", { id: "bw" + i }, gs);
        var ic = icon(w, s.ic, 560 - 52, 560 - 52, 4.3, s.c, 1.5, ""); ic.setAttribute("id", "bi" + i);
        txt("sn" + i, 700, 520, s.name, "ptl", s.c, 66, gs);
        if (i) { gsap.set("#bi" + i, { opacity: 0 }); gsap.set("#sn" + i, { opacity: 0 }); }
      });
      txt("tm", 700, 628, "09:58", "mono", C.text, 84, gs); document.getElementById("tm").setAttribute("font-weight", "bold");
      pill("dp", 1100, 428, 150, "10/7", "#222228", C.dim, 28, gs);
      hid(["#gs"]);

      /* ---- link pill + cursor (S2) ---- */
      var lk = grp("lk", gm);
      el("rect", { x: 630, y: 794, width: 340, height: 72, rx: 36, fill: "#1b2231", stroke: C.blue, "stroke-width": 3 }, lk);
      icon(lk, "link", 662, 812, 1.5, C.blue, 2);
      txt("lkT", 728, 831, "加入連結", "ptl", C.blue, 32, lk);
      hid(["#lk"]);
      var cur = grp("cur", gm);
      el("path", { d: "M0 0 L0 26 L7 20 L12 31 L17 29 L12 18 L21 18 Z", transform: "scale(1.9)", fill: C.text, stroke: "#0e0e10", "stroke-width": 2 }, cur);
      gsap.set(cur, { x: 1260, y: 880, opacity: 0 });

      /* ---- decision (S6-S8) ---- */
      txt("cap", 800, 352, "第一個進場的人", "pt", C.dim, 36, gm); hid(["#cap"]);
      var dm = grp("dm", gm);
      el("polygon", { id: "dFace", points: "800,400 1100,540 800,680 500,540", fill: C.card, stroke: C.edge, "stroke-width": 4, "stroke-linejoin": "round", filter: "url(#sh)" }, dm);
      icon(dm, "shield", 800 - 29, 466, 2.4, C.yellow, 1.8);
      txt("dT", 800, 590, "主持人授權？", "pt", C.text, 38, dm);
      hid(["#dm"]);
      line("dL", "M500 540 H380 V722", "ln", gm); line("dR", "M1100 540 H1220 V722", "ln", gm);
      prep("#dL"); prep("#dR");
      txt("lbN", 436, 506, "NO", "mono", C.dim, 32, gm, "middle"); txt("lbY", 1164, 506, "YES", "mono", C.dim, 32, gm, "middle"); hid(["#lbN", "#lbY"]);
      function result(id, x, ic, title, sub, color) {
        var g = grp(id, gm);
        el("rect", { class: "face", x: x, y: 722, width: 440, height: 150, rx: 24, fill: C.card, stroke: C.edge, "stroke-width": 4, filter: "url(#sh)" }, g);
        el("rect", { x: x + 24, y: 758, width: 80, height: 80, rx: 20, fill: "#25252a" }, g);
        icon(g, ic, x + 24 + 16, 758 + 16, 2, color, 1.7);
        txt(id + "T", x + 124, 790, title, "ptl", C.text, 36, g);
        txt(id + "S", x + 124, 836, sub, "ptl", color, 25, g);
        hid(["#" + id]); return g;
      }
      result("ca", 160, "users", "一般與會者", "能開會 · 不能主持", STEEL);
      result("cb", 1000, "crown", "共同主持人", "自動取得 · 可主持", C.green);
      function who(id, x, y, color) {
        var g = el("g", { id: id, transform: "translate(" + x + " " + y + ")" }, gm);
        var c = el("circle", { cx: 0, cy: 0, r: 34, fill: C.card, "stroke-width": 4 }, g); gsap.set(c, { stroke: color });
        icon(g, "user", -17, -17, 1.4, color, 2);
        gsap.set(g, { opacity: 0 });
      }
      who("whoA", 500, 540, STEEL); who("whoB", 1100, 540, C.green);

      /* ---- headline (S9) ---- */
      txt("h1", 800, 370, "誰先進場", "pt", C.text, 150, g9); hid(["#h1"]);
      var hl = el("rect", { id: "hl", x: 330, y: 470, width: 940, height: 200, rx: 26, fill: C.yellow }, g9); gsap.set(hl, { scaleX: 0, transformOrigin: "0% 50%" });
      txt("h2", 800, 572, "決定誰能主持", "pt", "#0e0e10", 116, g9); hid(["#h2"]);
      pill("wbx", 800, 780, 220, "WEBEX", "#1b2231", C.blue, 28, g9); hid(["#wbx"]);

      /* ================= timeline ================= */
      var SC = __SC__;
      var T = function (i) { return SC[i - 1]; };
      var t;
      function setState(a, b, at, color, kind) {
        tl.to("#sn" + a, { opacity: 0, duration: 0.15 }, at); tl.to("#bi" + a, { opacity: 0, duration: 0.15 }, at);
        tl.fromTo("#sn" + b, { opacity: 0, x: 14 }, { opacity: 1, x: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, at + 0.08);
        tl.to("#bi" + b, { opacity: 1, duration: 0.2 }, at + 0.08);
        tl.to("#gsRing", { stroke: color, duration: 0.25 }, at); tl.to("#gsFace", { stroke: color, duration: 0.25 }, at);
        if (kind) sfx(kind, at);
      }
      function clock(at, from, to, dur, every) {
        var o = { m: from }, e = document.getElementById("tm");
        tl.to(o, { m: to, duration: dur, ease: "none", onUpdate: function () { e.textContent = fmt(o.m); } }, at);
        var n = Math.floor((to - from) / every);
        for (var i = 1; i <= n; i++) sfx("tick", at + dur * (i * every) / (to - from));
      }
      function run(i, from, to, at, dur) {
        tl.to("#sf" + i, { scaleX: 1, duration: dur, ease: "none" }, at);
        tl.to("#ph", { x: to, duration: dur, ease: "none" }, at);
      }

      /* S1 : meeting created */
      t = T(1);
      V.fade("#tlb", t + 0.05); V.pop("#ph", t + 0.35, true); V.pop("#tkg0", t + 0.4, true);
      V.pop("#gs", t + 0.3);
      /* S2 : click link -> waiting */
      t = T(2);
      V.pop("#lk", t + 0.2); tl.set("#cur", { opacity: 1 }, t + 0.3);
      tl.to("#cur", { x: 835, y: 835, duration: 0.7, ease: "power2.inOut" }, t + 0.4);
      tl.to("#lk", { scale: 0.93, transformOrigin: "50% 50%", duration: 0.08, yoyo: true, repeat: 1 }, t + 1.2); sfx("tick", t + 1.2);
      tl.to("#cur", { opacity: 0, duration: 0.2 }, t + 1.55); tl.to("#lk", { opacity: 0, duration: 0.2 }, t + 1.55);
      setState(0, 1, t + 1.35, C.orange, "pop");
      V.pop("#segT0", t + 1.5, true);
      tl.to("#bw1", { rotation: 180, svgOrigin: "560 560", duration: 0.45, ease: "power2.inOut" }, t + 2.3);
      tl.to("#bw1", { rotation: 360, svgOrigin: "560 560", duration: 0.45, ease: "power2.inOut" }, t + 3.2);
      /* S3 : waiting until 11:15 */
      t = T(3);
      clock(t + 0.15, 598, 675, 2.5, 8); run(0, 0, 800, t + 0.15, 2.5);
      tl.to("#bw1", { rotation: 540, svgOrigin: "560 560", duration: 0.45, ease: "power2.inOut" }, t + 1.0);
      tl.to("#bw1", { rotation: 720, svgOrigin: "560 560", duration: 0.45, ease: "power2.inOut" }, t + 2.0);
      V.pop("#tkg1", t + 2.5, true);
      /* S4 : 11:15 early entry */
      t = T(4);
      setState(1, 2, t + 0.1, C.blue, "ding"); V.pop("#segT1", t + 0.15, true);
      clock(t + 0.6, 675, 690, 1.9, 5); run(1, 0, 1130, t + 0.6, 1.9);
      V.pop("#tkg2", t + 2.4, true);
      /* S5 : 11:30 meeting starts */
      t = T(5);
      setState(2, 3, t + 0.1, C.green, "ding"); V.pop("#segT2", t + 0.15, true);
      clock(t + 0.5, 690, 720, 1.9, 10); run(2, 0, 1500, t + 0.5, 1.9);
      V.pop("#tkg3", t + 2.4, true);
      /* S6 : the question */
      t = T(6);
      tl.to("#gs", { opacity: 0, duration: 0.25 }, t + 0.05);
      V.pop("#dm", t + 0.35); V.fade("#cap", t + 0.9);
      V.draw("#dL", t + 2.9, 0.5); V.draw("#dR", t + 2.9, 0.5);
      V.fade("#lbN", t + 3.2); V.fade("#lbY", t + 3.2);
      /* S7 : NO */
      t = T(7);
      tl.to("#lbN", { fill: C.text, duration: 0.2 }, t + 0.05); tl.to("#dR", { opacity: 0.25, duration: 0.25 }, t + 0.05);
      tl.set("#whoA", { opacity: 1 }, t + 0.15); V.along("#whoA", "#dL", t + 0.2, 0.9);
      tl.to("#whoA", { opacity: 0, duration: 0.15 }, t + 1.1);
      V.pop("#ca", t + 1.05); tl.to("#ca .face", { stroke: STEEL, duration: 0.25 }, t + 1.05);
      /* S8 : YES */
      t = T(8);
      tl.to("#dR", { opacity: 1, stroke: C.green, duration: 0.25 }, t + 0.05); tl.to("#dL", { opacity: 0.25, duration: 0.25 }, t + 0.05);
      tl.to("#lbY", { fill: C.green, duration: 0.2 }, t + 0.05);
      tl.set("#whoB", { opacity: 1 }, t + 0.1); V.along("#whoB", "#dR", t + 0.15, 0.8);
      tl.to("#whoB", { opacity: 0, duration: 0.15 }, t + 0.95);
      V.pop("#cb", t + 0.9); tl.to("#cb .face", { stroke: C.green, duration: 0.25 }, t + 0.9); sfx("ding", t + 0.95);
      /* S9 : headline */
      t = T(9);
      V.hide("#gm", t); V.show("#g9", t);
      V.pop("#h1", t + 0.05);
      tl.to("#hl", { scaleX: 1, duration: 0.35, ease: "power3.out" }, t + 0.25); sfx("draw", t + 0.25, 0.35);
      V.pop("#h2", t + 0.4); V.pop("#wbx", t + 0.8, true); sfx("chime", t + 0.8);

      tl.set({}, {}, TOTAL);
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
