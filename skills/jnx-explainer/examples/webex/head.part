<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="assets/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Poppins"; src: url("assets/fonts/Poppins-Medium.ttf"); font-weight: 500; }
      @font-face { font-family: "Poppins"; src: url("assets/fonts/Poppins-Bold.ttf"); font-weight: 700; }
      @font-face { font-family: "Mono"; src: url("assets/fonts/DejaVuSansMono.ttf"); font-weight: 400; }
      @font-face { font-family: "TC"; src: url("assets/fonts/TCMed.ttf"); font-weight: 500; }
      @font-face { font-family: "TC"; src: url("assets/fonts/TCBold.ttf"); font-weight: 700; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #0e0e10; }
      #root { position: relative; width: 100%; height: 100%; background: #0e0e10; }
      #scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .ln { fill: none; stroke: #34343a; stroke-width: 3; }
      .gl { fill: none; stroke: #4ade80; stroke-width: 4; }
      .mono { font-family: "Mono", "TC", monospace; dominant-baseline: central; }
      .pt { font-family: "Poppins", "TC", sans-serif; font-weight: 700; text-anchor: middle; dominant-baseline: central; }
      .ptl { font-family: "Poppins", "TC", sans-serif; font-weight: 700; text-anchor: start; dominant-baseline: central; }
      .ico { fill: none; stroke-linecap: round; stroke-linejoin: round; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="__TOTAL__" data-width="1920" data-height="1080">
      <svg id="scene" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="sh" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="6" stdDeviation="9" flood-color="#000000" flood-opacity="0.45" />
          </filter>
        </defs>
        <g id="world"></g>
      </svg>
      <audio id="vo" src="assets/vo.wav" data-start="0" data-duration="__TOTAL__" data-track-index="1" data-volume="1"></audio>
      <audio id="bgm" src="assets/bgm.wav" data-start="0" data-duration="__TOTAL__" data-track-index="2" data-volume="0.22"></audio>
      <audio id="sfx" src="assets/sfx.wav" data-start="0" data-duration="__TOTAL__" data-track-index="3" data-volume="0.75"></audio>
    </div>

    <script>
      var TOTAL = __TOTAL__;
      var SC = __SC__;
      var NS = "http://www.w3.org/2000/svg";
      var C = { card: "#19191c", edge: "#2c2c31", track: "#2a2a30", text: "#e8e6e3", dim: "#9a9aa3",
                orange: "#e0775b", green: "#4ade80", red: "#f4606c", blue: "#5b9cf5", yellow: "#f5d94a", amber: "#f5a623", grey: "#4a4a52" };
      var tl = gsap.timeline({ paused: true });
      window.SFX = [];
      function sfx(k, t, d) { window.SFX.push({ k: k, t: t, d: d || 0 }); }

      var IC = {
        check: '<path d="M20 6 9 17l-5-5"/>',
        x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
        list: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
        flask: '<path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/><path d="M8.5 2h7"/>',
        box: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/><path d="m7.5 4.27 9 5.15"/>',
        rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
        branch: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
        undo: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
        warn: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>'
      };
      function el(tag, attrs, parent) {
        var e = document.createElementNS(NS, tag);
        for (var k in attrs) e.setAttribute(k, attrs[k]);
        (parent || document.getElementById("world")).appendChild(e);
        return e;
      }
      function grp(id, parent) { return el("g", { id: id }, parent); }
      function txt(id, x, y, s, cls, fill, size, parent, anchor) {
        var t = el("text", { id: id, class: cls, x: x, y: y, fill: fill, "font-size": size }, parent);
        if (anchor) t.setAttribute("text-anchor", anchor);
        t.textContent = s; return t;
      }
      function icon(parent, name, x, y, sc, color, sw, cls) {
        var g = el("g", { class: "ico " + (cls || ""), transform: "translate(" + x + " " + y + ") scale(" + sc + ")", "stroke-width": sw }, parent);
        g.innerHTML = IC[name]; gsap.set(g, { stroke: color }); return g;
      }
      /* round status badge: ring + base icon + overlay icons */
      function badge(id, cx, cy, base, color, parent) {
        var g = grp(id, parent);
        var ring = el("circle", { class: "ring", cx: cx, cy: cy, r: 24, fill: C.card, "stroke-width": 3.5 }, g);
        gsap.set(ring, { stroke: color });
        icon(g, base, cx - 13, cy - 13, 1.08, color, 2.4, "base");
        return g;
      }
      function overlay(g, cx, cy, name, color, cls) { var i = icon(g, name, cx - 13, cy - 13, 1.08, color, 2.6, cls); gsap.set(i, { opacity: 0 }); return i; }
      function mascot(id, cx, cy, parent) {
        var g = grp(id, parent);
        el("circle", { cx: cx, cy: cy, r: 62, fill: "none", stroke: C.edge, "stroke-width": 2.5 }, g);
        var orb = el("g", {}, g); el("circle", { cx: cx + 62, cy: cy, r: 6, fill: C.orange }, orb);
        var m = el("g", { transform: "translate(" + (cx - 27) + " " + (cy - 24) + ")" }, g), s = 5;
        function px(x, y, w, h, f) { el("rect", { x: x * s, y: y * s, width: w * s, height: h * s, fill: f }, m); }
        px(2, 0, 1, 1, C.orange); px(8, 0, 1, 1, C.orange); px(0, 1, 11, 7, C.orange);
        px(3, 3, 1, 2, "#1a1210"); px(7, 3, 1, 2, "#1a1210"); px(4, 6, 3, 1, "#1a1210"); px(2, 8, 2, 1, C.orange); px(7, 8, 2, 1, C.orange);
        tl.to(orb, { rotation: 360 * (TOTAL / 3.2), svgOrigin: cx + " " + cy, ease: "none", duration: TOTAL }, 0);
        return g;
      }
      function pill(id, cx, cy, w, text, fill, color, size, parent) {
        var g = grp(id, parent);
        el("rect", { x: cx - w / 2, y: cy - 22, width: w, height: 44, rx: 22, fill: fill, stroke: color, "stroke-width": 2 }, g);
        txt(id + "T", cx, cy + 1, text, "mono", color, size || 19, g, "middle");
        return g;
      }
      function counter(id, x, y, label, parent) {
        var g = grp(id, parent);
        txt(id + "L", x, y, label, "mono", C.dim, 22, g);
        var v = txt(id + "V", x + 24 + label.length * 13.2, y, "0", "mono", C.text, 30, g); v.setAttribute("font-weight", "bold");
        return { g: g, v: v };
      }

      /* ---------- motion vocabulary (each helper also logs its sound) ---------- */
      var V = {
        pop: function (s, at, quiet) { tl.fromTo(s, { opacity: 0, scale: 0.8, transformOrigin: "50% 50%" }, { opacity: 1, scale: 1, duration: 0.28, ease: "back.out(2)", immediateRender: false }, at); if (!quiet) sfx("pop", at); },
        fade: function (s, at) { tl.fromTo(s, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out", immediateRender: false }, at); sfx("pop", at); },
        draw: function (s, at, dur) { tl.to(s, { strokeDashoffset: 0, duration: dur, ease: "power2.inOut" }, at); sfx("draw", at, dur); },
        stroke: function (s, to, at, kind) { tl.to(s, { stroke: to, duration: 0.25, ease: "power1.inOut" }, at); if (kind) sfx(kind, at); },
        fillc: function (s, to, at) { tl.to(s, { fill: to, duration: 0.25, ease: "power1.inOut" }, at); },
        show: function (s, at) { tl.set(s, { opacity: 1 }, at); },
        hide: function (s, at) { tl.set(s, { opacity: 0 }, at); },
        shake: function (s, at) { tl.to(s, { x: 8, duration: 0.05, yoyo: true, repeat: 5, ease: "none" }, at); tl.set(s, { x: 0 }, at + 0.32); sfx("warn", at); },
        /* progress bar: scaleX 0 -> to, color blue while running, then final color */
        bar: function (s, at, dur, to, run, done) {
          tl.set(s, { fill: run }, at);
          tl.to(s, { scaleX: to, duration: dur, ease: "power1.inOut" }, at);
          if (done) tl.to(s, { fill: done, duration: 0.2 }, at + dur);
          sfx("fill", at, dur);
        },
        resetBar: function (s, at) { tl.to(s, { scaleX: 0, duration: 0.2, ease: "power2.in" }, at); },
        /* icon swap inside a badge: base out, overlay in, ring + icon recolor */
        flip: function (id, over, color, at, kind) {
          V.stroke("#" + id + " .ring", color, at, kind);
          tl.to("#" + id + " .base", { opacity: 0, duration: 0.15 }, at);
          tl.to("#" + id + " ." + over, { opacity: 1, stroke: color, duration: 0.2 }, at + 0.05);
        },
        unflip: function (id, over, at) {   /* back to the base icon */
          tl.to("#" + id + " ." + over, { opacity: 0, duration: 0.15 }, at);
          tl.to("#" + id + " .base", { opacity: 1, duration: 0.15 }, at + 0.05);
        },
        swapText: function (a, b, at) { tl.to(a, { opacity: 0, duration: 0.15 }, at); tl.to(b, { opacity: 1, duration: 0.2 }, at + 0.05); },
        along: function (s, pathSel, at, dur, rev) {
          var p = document.querySelector(pathSel), L = p.getTotalLength(), e = document.querySelector(s), o = { u: 0 };
          tl.to(o, { u: 1, duration: dur, ease: "power2.inOut", onUpdate: function () {
            var pt = p.getPointAtLength((rev ? 1 - o.u : o.u) * L);
            e.setAttribute("transform", "translate(" + pt.x + " " + pt.y + ")");
          } }, at);
          sfx("travel", at, dur);
        },
        type: function (sel, text, at, per) {
          var e = document.querySelector(sel), o = { n: 0 };
          tl.to(o, { n: text.length, duration: text.length * per, ease: "none", onUpdate: function () { e.textContent = text.slice(0, Math.round(o.n)); } }, at);
          for (var i = 0; i < text.length; i++) sfx("key", at + i * per);
        },
        count: function (c, from, to, at, dur) {
          var o = { n: from }, n = Math.abs(to - from);
          tl.to(o, { n: to, duration: dur, ease: "none", onUpdate: function () { c.v.textContent = Math.round(o.n); } }, at);
          for (var i = 1; i <= n; i++) sfx("tick", at + dur * i / n);
        }
      };
      function prep(sel) { var e = document.querySelector(sel), L = e.getTotalLength(); gsap.set(e, { strokeDasharray: L + " " + (L + 40), strokeDashoffset: L + 8 }); }
      function line(id, d, cls, parent) { return el("path", { id: id, class: cls || "ln", d: d }, parent); }
