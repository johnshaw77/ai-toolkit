
      Object.assign(IC, {
        folder: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
        filetext: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
        user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
        clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>'
      });
      var BLUEBG = "#1b2231";
      function hid(l) { l.forEach(function (s) { gsap.set(s, { opacity: 0 }); }); }
      function windowFrame(id, x, y, w, h, parent) {
        var g = grp(id, parent);
        el("rect", { class: "face", x: x, y: y, width: w, height: h, rx: 22, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, g);
        el("path", { d: "M" + x + " " + (y + 56) + " H" + (x + w), stroke: C.edge, "stroke-width": 2 }, g);
        [C.red, C.yellow, C.green].forEach(function (c, i) { el("circle", { cx: x + 32 + i * 20, cy: y + 28, r: 6, fill: c, opacity: 0.85 }, g); });
        return g;
      }
      function pctText(id, v) { document.getElementById(id).textContent = Math.round(v) + "%"; }
      var G = []; for (var gi = 1; gi <= 9; gi++) { G[gi] = grp("g" + gi); gsap.set(G[gi], { opacity: 0 }); }

      /* ===== S1 : repeating yourself in chat ===== */
      var w1 = windowFrame("w1", 250, 170, 1100, 560, G[1]);
      txt("w1T", 380, 199, "新對話", "ptl", C.dim, 22, w1); 
      ["週一", "週二", "週三"].forEach(function (d, i) {
        var ry = 310 + i * 120;
        pill("dy" + i, 350, ry, 130, d, "#222228", C.dim, 24, G[1]);
        var b = grp("bb" + i, G[1]);
        el("rect", { x: 480, y: ry - 42, width: 820, height: 84, rx: 26, fill: BLUEBG, stroke: C.blue, "stroke-width": 2.5 }, b);
        txt("bbT" + i, 512, ry + 2, "請用繁中、先跑測試、附上結果", "ptl", C.text, 30, b);
        var bg = badge("rp" + i, 1262, ry, "undo", C.amber, b);
        hid(["#dy" + i, "#bb" + i]);
      });
      txt("rpL", 300, 676, "重複交代", "ptl", C.dim, 30, G[1]); 
      var rpv = txt("rpV", 500, 676, "0", "mono", C.red, 60, G[1]); rpv.setAttribute("font-weight", "bold"); hid(["#w1"]);

      /* ===== S2 : a folder ===== */
      var tree = grp("tree", G[2]);
      el("rect", { class: "face", x: 360, y: 190, width: 880, height: 520, rx: 24, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, tree);
      var ROWS = [{ n: "my-skill/", ic: "folder", c: C.amber, x: 420 }, { n: "SKILL.md", ic: "filetext", c: C.yellow, x: 500, tag: "指令" }, { n: "scripts/", ic: "folder", c: C.blue, x: 500, tag: "腳本" }, { n: "templates/", ic: "folder", c: C.green, x: 500, tag: "範本" }];
      el("rect", { id: "hlk", x: 400, y: 340, width: 800, height: 80, rx: 14, fill: C.yellow }, tree); gsap.set("#hlk", { opacity: 0 });
      ROWS.forEach(function (r, i) {
        var y = 290 + i * 100, g = grp("tr" + i, tree);
        icon(g, r.ic, r.x, y - 24, 2, r.c, 1.7);
        txt("trN" + i, r.x + 70, y + 2, r.n, "mono", C.text, 36, g);
        if (r.tag) pill("tag" + i, 1090, y, 150, r.tag, "#202024", r.c, 28, g);
        gsap.set(g, { opacity: 0 });
      });
      line("tln", "M440 322 V578", "ln", tree); [1, 2, 3].forEach(function (i) { line("tlh" + i, "M440 " + (290 + i * 100) + " H480", "ln", tree); prep("#tlh" + i); }); prep("#tln");
      hid(["#tree"]);

      /* ===== S3 : SKILL.md ===== */
      var w3 = windowFrame("w3", 250, 170, 1100, 560, G[3]);
      txt("w3T", 380, 199, "SKILL.md", "mono", C.dim, 24, w3);
      el("rect", { id: "hn", x: 280, y: 369, width: 1040, height: 54, rx: 10, fill: C.yellow }, w3); el("rect", { id: "hd", x: 280, y: 427, width: 1040, height: 54, rx: 10, fill: C.yellow }, w3); gsap.set(["#hn", "#hd"], { opacity: 0 });
      var LN = [["---", null, C.dim], ["name:", "code-review", C.blue], ["description:", "審查 PR 時使用", C.blue], ["---", null, C.dim], ["1. 先跑 lint", null, C.dim], ["2. 再跑測試", null, C.dim], ["3. 附上報告", null, C.dim]];
      LN.forEach(function (l, i) {
        var y = 338 + i * 58;
        txt("ml" + i, 310, y, l[0], "mono", l[2], 32, w3);
        if (l[1]) txt("mv" + i, 310 + (l[0].length + 1) * 19.3, y, l[1], "mono", C.text, 32, w3);
        hid(["#ml" + i, "#mv" + i].filter(function (s) { return document.querySelector(s); }));
      });
      pill("tg1", 1200, 338 + 58, 110, "名稱", "#2a2410", C.yellow, 26, w3); pill("tg2", 1200, 338 + 116, 110, "描述", "#2a2410", C.yellow, 26, w3); hid(["#tg1", "#tg2", "#w3"]);

      /* ===== S4/S5 : skills list + context ===== */
      var SK = ["code-review", "deploy", "sql-report", "api-docs", "release-note"];
      SK.forEach(function (n, i) {
        var y = 200 + i * 108, g = grp("sk" + i, G[4]);
        el("rect", { class: "face", x: 180, y: y, width: 540, height: 90, rx: 18, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, g);
        el("rect", { x: 200, y: y + 17, width: 56, height: 56, rx: 14, fill: "#25252a" }, g); icon(g, "filetext", 212, y + 29, 1.3, C.text, 1.8);
        txt("skN" + i, 276, y + 34, n, "mono", C.text, 28, g);
        el("rect", { x: 276, y: y + 56, width: [260, 200, 230, 180, 220][i], height: 10, rx: 5, fill: C.track }, g);
        gsap.set(g, { opacity: 0 });
      });
      var cx = grp("cx", G[4]);
      el("rect", { class: "face", x: 820, y: 290, width: 620, height: 340, rx: 24, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, cx);
      icon(cx, "box", 856, 322, 1.4, C.text, 1.8); txt("cxH", 910, 346, "Claude  context", "ptl", C.text, 28, cx);
      var cxv = txt("cxV", 860, 468, "8%", "mono", C.text, 100, cx); cxv.setAttribute("font-weight", "bold");
      el("rect", { x: 860, y: 520, width: 540, height: 36, rx: 18, fill: C.track }, cx);
      var cxf = el("rect", { id: "cxF", x: 860, y: 520, width: 540, height: 36, rx: 18, fill: C.blue }, cx); gsap.set(cxf, { scaleX: 0.08, transformOrigin: "0% 50%" });
      txt("cxC1", 860, 598, "只有 名稱 + 描述", "ptl", C.dim, 26, cx); 
      txt("cxC2", 860, 598, "+ 完整指令", "ptl", C.blue, 26, cx);  gsap.set("#cxC2", { opacity: 0 });
      gsap.set(cx, { opacity: 0 });
      var bub = grp("bub", G[4]);
      el("rect", { x: 820, y: 190, width: 620, height: 72, rx: 24, fill: BLUEBG, stroke: C.blue, "stroke-width": 2.5 }, bub); txt("bubT", 856, 227, "幫我審這個 PR", "ptl", C.text, 30, bub); gsap.set(bub, { opacity: 0 });
      line("cn45", "M720 245 C775 245 770 450 820 450", "ln", G[4]); prep("#cn45");

      /* ===== S6 : scripts + templates ===== */
      var w6 = windowFrame("w6", 200, 200, 800, 440, G[6]);
      txt("w6T", 330, 229, "terminal", "mono", C.dim, 22, w6);
      txt("c0", 240, 320, "", "mono", C.text, 30, w6);
      ["✓ lint ok", "✓ 12 tests ok", "✓ report.md saved"].forEach(function (s, i) { var t = txt("cr" + i, 240, 390 + i * 56, s, "mono", C.green, 30, w6); gsap.set(t, { opacity: 0 }); });
      pill("p6a", 600, 160, 130, "腳本", "#1b2231", C.blue, 26, G[6]);
      var tc = grp("tc", G[6]);
      el("rect", { class: "face", x: 1080, y: 200, width: 320, height: 440, rx: 22, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, tc);
      icon(tc, "filetext", 1180, 250, 4.5, C.text, 1.4); txt("tcN", 1240, 400, "report.md", "mono", C.text, 28, tc, "middle");
      [0, 1, 2].forEach(function (i) { el("rect", { x: 1120, y: 450 + i * 40, width: [240, 200, 220][i], height: 12, rx: 6, fill: C.track }, tc); });
      pill("p6b", 1240, 160, 130, "範本", "#10261a", C.green, 26, G[6]); hid(["#w6", "#p6a", "#tc", "#p6b"]);

      /* ===== S7 : everyone follows the same standard ===== */
      var t7 = grp("t7", G[7]);
      el("rect", { class: "face", x: 250, y: 190, width: 1100, height: 500, rx: 24, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, t7);
      ["小明", "小華", "小美"].forEach(function (n, i) {
        var y = 280 + i * 130, g = grp("rw" + i, t7);
        icon(g, "user", 296, y - 20, 1.7, C.dim, 1.8); txt("rwN" + i, 356, y + 2, n, "ptl", C.text, 34, g);
        ["lint", "測試", "報告"].forEach(function (l, k) {
          var bx = 640 + k * 190, bg = badge("b" + i + k, bx, y, "clock", C.grey, g); overlay(bg, bx, y, "check", C.green, "ok");
          txt("bl" + i + k, bx + 36, y + 2, l, "mono", C.dim, 24, g);
        });
        pill("rg" + i, 1262, y, 110, "一致", "#10261a", C.green, 24, g); gsap.set("#rg" + i, { opacity: 0 }); gsap.set(g, { opacity: 0 });
      });
      txt("rzL", 300, 650, "重複交代", "ptl", C.dim, 30, t7); 
      var rzv = txt("rzV", 500, 650, "0", "mono", C.green, 60, t7); rzv.setAttribute("font-weight", "bold"); hid(["#t7"]);
      /* ===== S8 : shared with the whole team ===== */
      var rp = grp("repo", G[8]);
      el("rect", { class: "face", x: 140, y: 360, width: 420, height: 180, rx: 22, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, rp);
      icon(rp, "folder", 176, 400, 2.4, C.amber, 1.7); txt("rpN", 250, 430, ".claude/skills", "mono", C.text, 28, rp); pill("rpP", 350, 500, 190, "my-skill", "#2a2410", C.yellow, 24, rp); hid(["#repo"]);
      for (var pi = 0; pi < 5; pi++) {
        var py = 236 + pi * 118, pg = grp("pe" + pi, G[8]);
        el("rect", { class: "face", x: 1020, y: py - 46, width: 420, height: 92, rx: 20, fill: C.card, stroke: C.edge, "stroke-width": 3, filter: "url(#sh)" }, pg);
        icon(pg, "user", 1050, py - 20, 1.7, C.dim, 1.8); txt("peN" + pi, 1112, py + 2, "dev " + (pi + 1), "mono", C.text, 28, pg);
        var bg2 = badge("pb" + pi, 1390, py, "clock", C.grey, pg); overlay(bg2, 1390, py, "check", C.green, "ok"); gsap.set(pg, { opacity: 0 });
        line("pth" + pi, "M560 450 C790 450 790 " + py + " 1020 " + py, "ln", G[8]); prep("#pth" + pi);
        var ch = el("g", { id: "ch" + pi, transform: "translate(560 450)" }, G[8]);
        el("circle", { cx: 0, cy: 0, r: 26, fill: C.card, stroke: C.yellow, "stroke-width": 3.5 }, ch); icon(ch, "filetext", -13, -13, 1.08, C.yellow, 2.2); gsap.set(ch, { opacity: 0 });
      }
      /* ===== S9 : headline ===== */
      txt("h1", 800, 350, "Skill =", "pt", C.text, 130, G[9]); hid(["#h1"]);
      var hl = el("rect", { id: "hl", x: 300, y: 440, width: 1000, height: 200, rx: 26, fill: C.yellow }, G[9]); gsap.set(hl, { scaleX: 0, transformOrigin: "0% 50%" });
      txt("h2", 800, 543, "寫給 AI 的 SOP", "pt", "#0e0e10", 104, G[9]); hid(["#h2"]);
      pill("wbx", 800, 750, 240, "SKILL.md", BLUEBG, C.blue, 28, G[9]); hid(["#wbx"]);

      /* ================= timeline ================= */
      var T = function (i) { return SC[i - 1]; };
      var t;
      function scene(i, grps) { grps.forEach(function (g) { V.hide(G[g], T(i)); }); }
      /* S1 */
      t = T(1); V.show(G[1], t);
      V.pop("#w1", t + 0.05);
      for (var i = 0; i < 3; i++) {
        var a = t + 0.6 + i * 0.85;
        V.fade("#dy" + i, a); V.pop("#bb" + i, a + 0.15, true);
        tl.set("#rpV", { textContent: String(i + 1) }, a + 0.3); sfx("tick", a + 0.3);
      }
      tl.to("#rpV", { scale: 1.15, transformOrigin: "0% 50%", duration: 0.12, yoyo: true, repeat: 1 }, t + 3.0); sfx("warn", t + 3.0);
      /* S2 */
      t = T(2); V.hide(G[1], t); V.show(G[2], t);
      V.pop("#tree", t + 0.05); V.fade("#tr0", t + 0.4);
      V.draw("#tln", t + 0.8, 0.5);
      for (var i = 1; i <= 3; i++) { V.draw("#tlh" + i, t + 1.0 + (i - 1) * 0.4, 0.2); V.fade("#tr" + i, t + 1.15 + (i - 1) * 0.4); }
      tl.to("#hlk", { opacity: 0.14, duration: 0.3 }, t + 2.4);
      /* S3 */
      t = T(3); V.hide(G[2], t); V.show(G[3], t);
      V.pop("#w3", t + 0.05);
      for (var i = 0; i < LN.length; i++) { tl.to(["#ml" + i, "#mv" + i], { opacity: 1, duration: 0.2 }, t + 0.4 + i * 0.12); }
      sfx("pop", t + 0.4);
      tl.to("#hn", { opacity: 0.14, duration: 0.3 }, t + 1.5); V.pop("#tg1", t + 1.5);
      tl.to("#hd", { opacity: 0.14, duration: 0.3 }, t + 2.5); V.pop("#tg2", t + 2.5);
      /* S4 */
      t = T(4); V.hide(G[3], t); V.show(G[4], t);
      for (var i = 0; i < 5; i++) V.fade("#sk" + i, t + 0.15 + i * 0.15);
      V.pop("#cx", t + 1.0);
      /* S5 */
      t = T(5);
      V.pop("#bub", t + 0.2);
      for (var i = 1; i < 5; i++) tl.to("#sk" + i, { opacity: 0.3, duration: 0.25 }, t + 0.8);
      tl.to("#sk0 .face", { stroke: C.yellow, duration: 0.2 }, t + 0.8);
      V.draw("#cn45", t + 1.2, 0.45);
      tl.to("#sk0 .face", { stroke: C.green, duration: 0.25 }, t + 1.7); sfx("ding", t + 1.7);
      (function () { var o = { v: 8 }; tl.to(o, { v: 34, duration: 0.9, ease: "power2.out", onUpdate: function () { pctText("cxV", o.v); } }, t + 1.8); })();
      tl.to("#cxF", { scaleX: 0.34, duration: 0.9, ease: "power2.out" }, t + 1.8); for (var k = 1; k <= 5; k++) sfx("tick", t + 1.8 + 0.9 * k / 5);
      tl.to("#cxC1", { opacity: 0, duration: 0.15 }, t + 1.8); tl.to("#cxC2", { opacity: 1, duration: 0.2 }, t + 1.9);
      /* S6 */
      t = T(6); V.hide(G[4], t); V.show(G[6], t);
      V.pop("#w6", t + 0.05); V.pop("#p6a", t + 0.2, true);
      V.type("#c0", "$ python check.py", t + 0.5, 0.04);
      tl.to("#cr0", { opacity: 1, duration: 0.15 }, t + 1.4); sfx("ding", t + 1.4);
      tl.to("#cr1", { opacity: 1, duration: 0.15 }, t + 1.75); sfx("ding", t + 1.75);
      V.pop("#tc", t + 1.9); V.pop("#p6b", t + 2.0, true); tl.to("#tc .face", { stroke: C.green, duration: 0.25 }, t + 2.1);
      tl.to("#cr2", { opacity: 1, duration: 0.15 }, t + 2.3);
      /* S7 */
      t = T(7); V.hide(G[6], t); V.show(G[7], t);
      V.pop("#t7", t + 0.05);
      for (var i = 0; i < 3; i++) {
        var a = t + 0.3 + i * 0.7;
        V.fade("#rw" + i, a);
        for (var k = 0; k < 3; k++) V.flip("b" + i + k, "ok", C.green, a + 0.2 + k * 0.15, "tick");
        V.pop("#rg" + i, a + 0.65, true);
      }
      sfx("ding", t + 2.9);
      /* S8 */
      t = T(8); V.hide(G[7], t); V.show(G[8], t);
      V.pop("#repo", t + 0.05);
      for (var i = 0; i < 5; i++) {
        V.fade("#pe" + i, t + 0.3 + i * 0.1);
        V.draw("#pth" + i, t + 0.8 + i * 0.08, 0.3);
        tl.set("#ch" + i, { opacity: 1 }, t + 1.2 + i * 0.12); V.along("#ch" + i, "#pth" + i, t + 1.2 + i * 0.12, 0.6);
        tl.to("#ch" + i, { opacity: 0, duration: 0.12 }, t + 1.85 + i * 0.12);
        V.flip("pb" + i, "ok", C.green, t + 1.85 + i * 0.12, "tick");
      }
      sfx("ding", t + 2.6);
      /* S9 */
      t = T(9); V.hide(G[8], t); V.show(G[9], t);
      V.pop("#h1", t + 0.05);
      tl.to("#hl", { scaleX: 1, duration: 0.35, ease: "power3.out" }, t + 0.25); sfx("draw", t + 0.25, 0.35);
      V.pop("#h2", t + 0.4); V.pop("#wbx", t + 0.9, true); sfx("chime", t + 0.9);

      tl.set({}, {}, TOTAL);
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
