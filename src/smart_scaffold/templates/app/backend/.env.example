# 複製成 .env 再改。.env 已經在 .gitignore 裡，不會被 commit。

# 資料庫連線字串。
# 預設用 sqlite，開箱即跑、不需要任何外部服務。
# 要換 PostgreSQL 的話先 `docker compose up -d db`，再改成下面那行：
#   postgresql+asyncpg://{{db_user}}:{{db_password}}@127.0.0.1:{{db_port}}/{{name}}
# 預設：sqlite+aiosqlite:///./{{name}}.db
DATABASE_URL={{database_url}}

# JWT 簽章金鑰。**上線前一定要換掉**，換掉之後既有的 token 全部失效。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 預設：dev-only-change-me-before-deploying-anywhere-0123456789
SECRET_KEY=dev-only-change-me-before-deploying-anywhere-0123456789

# access token 有效時間（分鐘）。短一點比較安全，靠 refresh token 續命。
# 預設：15
ACCESS_TOKEN_EXPIRE_MINUTES=15

# refresh token 有效時間（天）。
# 預設：7
REFRESH_TOKEN_EXPIRE_DAYS=7

# 允許跨來源請求的前端網址，逗號分隔。前端換埠的話這裡要跟著改。
# 預設：http://127.0.0.1:{{frontend_port}},http://localhost:{{frontend_port}}
CORS_ORIGINS=http://127.0.0.1:{{frontend_port}},http://localhost:{{frontend_port}}

# 是否把 SQLAlchemy 產生的 SQL 印出來。除錯時才開。
# 預設：false
SQL_ECHO=false

# 建立初始管理員用的帳密（跑 `uv run python -m app.seed` 時會用到）。
# 預設：admin@example.com / admin1234
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
