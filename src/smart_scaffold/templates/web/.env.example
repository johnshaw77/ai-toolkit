# 複製成 .env 再改。.env 已經在 .gitignore 裡，不會被 commit。

# 執行環境：dev / staging / prod。影響是否顯示除錯資訊。
# 預設：dev
APP_ENV=dev

# 服務監聽的埠。已經替你避開機器上正在用的埠了。
# 預設：{{port}}
APP_PORT={{port}}

# 資料庫檔案位置（相對於專案根目錄）。
# 預設：data/{{name}}.db
DATABASE_PATH=data/{{name}}.db

# 簽 session cookie 用的金鑰。**上線前一定要換掉**，換掉之後所有人會被登出。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 預設：dev-only-change-me-before-deploying-anywhere-0123456789
SECRET_KEY=dev-only-change-me-before-deploying-anywhere-0123456789

# 登入狀態保留多久（秒）。預設 7 天。
# 預設：604800
SESSION_MAX_AGE=604800

# log 等級：DEBUG / INFO / WARNING / ERROR。
# 預設：INFO
LOG_LEVEL=INFO

# 初始管理員帳密（跑 `uv run {{name}} seed` 時會用到）。
# 預設：admin@example.com / admin1234
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
