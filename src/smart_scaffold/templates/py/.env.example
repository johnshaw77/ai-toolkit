# 複製成 .env 再改。.env 已經在 .gitignore 裡，不會被 commit。
#
# 每個變數都寫清楚用途與預設值——半年後回來看才知道能不能動。

# 執行環境：dev / staging / prod。影響 log 等級與是否開啟除錯輸出。
# 預設：dev
APP_ENV=dev

# log 等級：DEBUG / INFO / WARNING / ERROR。
# 預設：INFO
LOG_LEVEL=INFO

# 服務監聽的埠。已經替你避開機器上正在用的埠了。
# 預設：{{port}}
APP_PORT={{port}}

# 外部 API 金鑰。沒有就留空，程式會跳過需要它的功能。
# 預設：（空）
API_KEY=
